#define UFSRVCLILIB_DEBUG_BUILD_L3 @UFSRVCLILIB_DEBUG_L3@      /* level-3 per-object tracing */

#cmakedefine UFSRVCLILIB_WITH_PROTOBUF_C 1
#cmakedefine UFSRVCLILIB_WITH_CURL       1
#cmakedefine UFSRVCLILIB_WITH_OPENSSL    1

