#ifndef UFSRVCLILIB_CONFIG_H
#define UFSRVCLILIB_CONFIG_H

#define UFSRVCLILIB_CONFIG_VERSION       "@UFSRVCLILIB_VERSION@"
#define UFSRVCLILIB_CONFIG_BUILT_SHARED  @UFSRVCLILIB_BUILT_SHARED@

#define UFSRVCLILIB_DEBUG_BUILD    @UFSRVCLILIB_DEBUG_BUILD@   /* 1 for Debug builds, or when a verbosity level is on */
